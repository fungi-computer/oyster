  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json && tsc -p src/page/tsconfig.build.json && node scripts/build-page.mjs && node scripts/build-candidate-cli.mjs",
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "typecheck": "tsc --noEmit && tsc -p src/page/tsconfig.json && tsc -p examples/tsconfig.json && tsc -p examples/notes-app/ui/tsconfig.json && tsc -p src/build/tsconfig.json && tsc -p src/build/snapshot-programs/tsconfig.json && tsc -p test/build/tsconfig.json && tsc -p test/page/tsconfig.json && tsc -p test/standalone/tsconfig.json",
    "test": "pnpm run test:boot-ui && node test/core.mjs && vitest run --config vitest.config.mjs && vitest run --config vitest.browser.config.mjs && node --test test/mcp-catalog.test.mjs test/agent-catalog-memory.test.mjs test/agent-catalog-cap.test.mjs test/mcp-isolate.test.mjs test/mcp-owner.test.mjs test/pack.test.mjs test/auth.test.mjs test/host-pages.test.mjs && node test/files.mjs && node --test test/startup-graph.test.mjs test/idle-heap.test.mjs test/guest-security.test.mjs test/host-routes.test.mjs test/key-routes.test.mjs test/app-calls.test.mjs test/computer-caller.test.mjs test/capabilities.test.mjs test/app-agent-scope.test.mjs test/bindings.test.mjs test/no-darkroom.test.mjs test/authorization-law.test.mjs test/git-key-scope.test.mjs test/owner-only-admission.test.mjs && node --import tsx --test test/authorization.test.ts test/page-capabilities.test.mjs test/approval-page.test.mjs test/approval-native-control.test.mjs test/approval-handoff.test.mjs test/grant-consent-fixture.test.mjs test/external-app.test.mjs test/retired-frame-binding.test.mjs test/machine-link/home.test.mjs test/machine-link/enrollment.test.ts test/machine-link/fences.test.ts test/machine-link/audience.test.ts test/machine-link/presence.test.ts test/machine-link/client.test.ts test/machine-link/delivery.test.ts test/machine-link/custody.test.ts test/machine-link/replay-capacity.test.ts && node --test test/app-build-contract.test.mjs test/captured-app.test.mjs && node test/agents.mjs && node --test test/connections.test.mjs && node test/git-transport.mjs && node --test test/artifacts-git.test.mjs test/git-credential-reuse.test.mjs && node --import tsx --test test/invocation-race.test.ts && node --import tsx test/git-admission.mjs && node --import tsx --test test/root-data.test.ts && node --test test/root-host.test.mjs test/page-lifetime.test.mjs test/registry-replacement.test.mjs test/installation-commit-race.test.mjs && node --import tsx --test test/older-oyster-store.test.mjs && node --import tsx --test test/tenant-scope.test.mjs test/tenant-host.test.mjs test/tenant-principal.test.mjs && vitest run --config vitest.tenancy-node.config.mjs && vitest run --config vitest.tenancy-cloudflare.config.mjs && vitest run --config vitest.tenancy-cloudflare-eviction.config.mjs && vitest run --config vitest.tenancy-cold-directory.config.mjs && pnpm run test:web && pnpm run test:standalone",
    "lint": "eslint src test examples --max-warnings=0 && oxlint --config ../../oxlint.config.ts --deny-warnings src test examples",
    "format:check": "node ../../tooling/repository/scripts/format-package-check.mjs",
    "lint:anti-slop": "node ../../tooling/repository/scripts/lint-package-anti-slop.mjs",
    "docs": "tsx ../../tooling/repository/src/docs/cli.ts check --root ../..",
    "docs:write": "tsx ../../tooling/repository/src/docs/cli.ts write --root ../..",
    "pack": "mkdir -p ../../.botanical/oyster-pack && pnpm pack --pack-destination \"$PWD/../../.botanical/oyster-pack\"",
    "smoke": "node test/stranger/runtime.mjs",
    "stranger": "tsx ../../tooling/repository/src/artifacts/cli.ts --repo-root ../.. .",
    "test:packed-native": "node --import tsx test/stranger/qualify-packed.mjs",
    "test:background-replay": "node test/background-replay.native.mjs",
    "test:web": "vitest run --reporter=default --config vitest.web.config.mjs",
    "test:standalone": "vitest run --config vitest.standalone.config.mjs && node --import tsx --test test/standalone/agent-caller.test.mjs test/standalone/workers-media.test.mjs test/standalone/workers-computer.test.mjs test/standalone/workflow-git-pass-frame.test.mjs test/standalone/webhook-abuse.test.mjs test/standalone/webhook-custody.test.mjs test/standalone/webhook-ingress.test.mjs test/standalone/workers-workflows.test.mjs test/standalone/workflow-provider.test.mjs test/standalone/standalone-tenancy.test.mjs test/standalone/standalone-registry.test.mjs && node --import tsx test/standalone/agent-key-access.proof.mjs",
    "test:visitor-edge-browser": "node test/standalone/visitor-edge.browser.mjs",
    "test:website-channel-browser": "node test/standalone/website-channel.browser.mjs",
    "test:visitor-edge-native": "node test/standalone/visitor-edge.native.mjs",
    "test:source-builds": "node test/source-distribution-build.native.mjs",
    "test:git-door": "node test/git-example.native.mjs",
    "test:page-launch": "node --test test/page-launch.browser.mjs",
    "test:standalone:celld": "CELLD_PLATFORM_CELLD=$(../../tooling/celld-platform/runtime/pinned-celld.sh) node --import ../../tooling/celld-platform/runtime/wrangler-on-celld.mjs test/standalone.native.mjs",
    "test:approval-wake:celld": "CELLD_PLATFORM_CELLD=$(../../tooling/celld-platform/runtime/pinned-celld.sh) node test/approval-wake.native.mjs",
    "prepack": "node scripts/prepare-package.mjs",
    "test:storage-backend:celld": "CELLD_PLATFORM_CELLD=$(../../tooling/celld-platform/runtime/pinned-celld.sh) node --import ../../tooling/celld-platform/runtime/wrangler-on-celld.mjs test/storage-backend.native.mjs",
    "test:recovery-copy:celld": "CELLD_PLATFORM_CELLD=$(../../tooling/celld-platform/runtime/pinned-celld.sh) node --import ../../tooling/celld-platform/runtime/wrangler-on-celld.mjs test/recovery-copy.native.mjs",
    "test:grant-consent": "node --import tsx --test --test-concurrency=1 test/grant-consent.browser.mjs test/app-permissions.browser.mjs",
    "test:shell-entry": "node --import tsx --test test/shell-entry.browser.mjs",
    "test:grant-consent:native": "bash scripts/check-grant-consent-native.sh",
    "test:mcp-owner:celld": "CELLD_PLATFORM_CELLD=$(../../tooling/celld-platform/runtime/pinned-celld.sh) node --import ../../tooling/celld-platform/runtime/wrangler-on-celld.mjs test/mcp-owner.native.mjs",
    "dev": "wrangler dev --config deploy/wrangler.jsonc --ip 127.0.0.1 --port 8797",
    "check:startup": "node scripts/check-startup.mjs",
    "test:app-fork": "node --import tsx test/standalone/app-fork.native.mjs",
    "test:landed-push": "node --import tsx test/standalone/landed-push.native.mjs",
    "test:computer-egress": "node --import tsx test/standalone/computer-egress.native.mjs",
    "test:model-keys-browser": "bash ../../tooling/proof-runner/run-proof.sh node --import tsx test/standalone/model-keys.browser.mjs",
    "test:computer-egress-browser": "bash ../../tooling/proof-runner/run-proof.sh node --import tsx test/standalone/computer-egress.browser.mjs",
    "test:nightly": "pnpm run test:first-issue && pnpm run test:background-replay && pnpm run test:git-door && pnpm run test:approval-wake:celld && pnpm run test:recovery-copy:celld && pnpm run test:standalone:celld && pnpm run test:storage-backend:celld && pnpm run test:mcp-owner:celld && pnpm run test:mcp-computer && pnpm run test:mcp-fleet && pnpm run test:local-backend && pnpm run test:agents && pnpm run test:app-fork && pnpm run test:landed-push && pnpm run test:loader-workflows && pnpm run test:seed-demo && pnpm run test:shell-entry && pnpm run test:page-launch && pnpm run test:host-pages:browser && pnpm run test:visitor-edge-native && pnpm run test:visitor-edge-browser && pnpm run test:website-channel-browser && pnpm run test:boot-browser && pnpm run test:grant-consent && pnpm run test:grant-consent:native && pnpm run test:source-builds && pnpm run test:packed-native && pnpm run test:workflows && pnpm run test:computer-egress && pnpm run test:computer-egress-browser && pnpm run test:workspace-build-native",
    "test:loader-workflows": "node --import tsx test/standalone/loader-workflows.native.mjs",
    "test:workflows": "node --import tsx test/standalone/workflows.native.mjs",
    "test:agents": "node test/standalone/agents-sandbox.native.mjs && node test/standalone/agent-model-choice.native.mjs && node --import tsx test/standalone/agent-computers.native.mjs",
    "proof:agent-browser": "node test/standalone/agent-browser.native.mjs",
    "test:mcp-computer": "node test/standalone/mcp-computer.native.mjs",
    "test:mcp-fleet": "node test/standalone/mcp-fleet.native.mjs",
    "test:local-backend": "node test/standalone/local-backend.native.mjs",
    "test:first-issue": "node test/standalone/try-first-issue.browser.mjs",
    "proof:try-hello": "node test/standalone/try-hello.browser.mjs",
    "capture:tourtois-home": "node test/standalone/tourtois-home.browser.mjs",
    "capture:shell-fork": "OYSTER_PROOF_SHELL_FORK=1 node test/standalone/tourtois-home.browser.mjs",
    "capture:gills": "OYSTER_PROOF_GILLS=1 node --import tsx test/standalone/tourtois-home.browser.mjs",
    "capture:app-set": "OYSTER_PROOF_APP_SET=1 node test/standalone/tourtois-home.browser.mjs",
    "proof:starter-apps": "node --import tsx test/standalone/starter-apps.native.mjs",
    "test:seed-demo": "node --import tsx test/standalone/seed-demo.browser.mjs",
    "capture:edit-in-inkcap": "node --import tsx test/standalone/edit-in-inkcap-live.browser.mjs",
    "install:apps": "node --import tsx src/standalone/install-apps-bin.ts install-apps --from ../..",
    "check:deploy": "wrangler deploy --dry-run --config deploy/wrangler.jsonc --containers-rollout=none --outdir=.botanical/worker",
    "test:boot-ui": "node --import tsx --test test/boot-ui-references.test.mjs test/boot-capability-registry.test.mjs test/boot-capability-route.test.mjs",
    "test:boot-browser": "node --test test/boot-page.browser.mjs && pnpm run test:browser-onbox",
    "test:browser-onbox": "CELLD_PLATFORM_CELLD=$(../../tooling/celld-platform/runtime/pinned-celld.sh) node --import ../../tooling/celld-platform/runtime/wrangler-on-celld.mjs test/browser/onbox-context.proof.mjs",
    "test:host-pages": "node --test test/auth.test.mjs test/host-routes.test.mjs test/root-host.test.mjs test/host-pages.test.mjs",
    "test:host-pages:browser": "node --test test/host-pages.browser.mjs",
    "test:workspace-build-native": "node --import tsx --test test/workspace-build-script.native.ts"
  },
