    "@fungi.computer/forage": "workspace:*",
    "@fungi.computer/gills": "workspace:*",
    "@fungi.computer/knapsack": "workspace:*",
    "@fungi.computer/mycelium": "workspace:*",
    "@fungi.computer/puffball": "workspace:*",
    "@fungi.computer/sigils": "workspace:*",
    "@fungi.computer/watchdog": "workspace:*",
    "@fungi.computer/whistle": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "@pnpm/lockfile.fs": "1100.2.13",
    "@pnpm/lockfile.pruner": "1100.0.27",
    "@fungi.computer/capnweb": "workspace:*",
    "effect": "4.0.2",
    "esbuild": "0.28.2",
    "fast-json-stable-stringify": "2.1.0",
    "hono": "4.13.5",
    "isomorphic-git": "1.42.2",
    "jose": "6.2.11",
    "memfs": "4.80.0",
    "mime": "4.1.0",
    "path-to-regexp": "8.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260828.1",
    "@fungi.computer/shiitake": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "@tailwindcss/node": "4.2.1",
    "@tailwindcss/oxide": "4.2.1",
    "@types/node": "24.13.3",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.62.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.11",
    "wrangler": "4.127.1",
    "eslint": "10.9.1",
    "oxlint": "1.78.0",
    "tsx": "4.23.12"
  },
  "license": "MIT",
  "botanical": {
    "role": "package",
    "operations": {
      "lint": "required",
      "typecheck": "required",
      "build": "required",
      "test": "required",
      "docs": "required",
      "pack": "required",
      "smoke": "required",
      "stranger": "required"
    }
  },
  "publishConfig": {
    "directory": ".botanical/package",
    "linkDirectory": false
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.2.0",
    "wrangler": "^4.127.1"
  },
  "peerDependenciesMeta": {
    "wrangler": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fungi-computer/oyster.git"
  },
  "fungi": {
    "build": {
      "typescript": [
        "src/shell/tsconfig.build.json"
      ]
    }
  }
